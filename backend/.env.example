# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://attendance-monitoring-system-dun.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://attendance-monitoring-system-dun.vercel.app

# Render provides this automatically when the web service is linked to Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# Optional local fallback used only when DATABASE_URL is not set.
POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=attendancesystem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
